<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The phone's own calendar store, which DAVx5 or an account's sync adapter fills. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      To fetch the calendar links the person adds (Settings, Add calendar link), when the app
      opens and on a pull down; and, only once the person signs in to their own calendar server
      (Settings, Calendar server), to sync with that server, in the background as well.
      Nothing goes anywhere else.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Datebook's own calendar sync account (CalDAV): turning its sync on and reading its state. -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />

    <!-- Only while the QR scanner for a calendar link is open. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Calendar sync's "Wi-Fi only": whether the phone is on Wi-Fi now. Nothing else is read. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Reminders: a notification, the event on the whole screen, and an alarm to wake for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the text-selection menu see other apps' text actions, such as Define from the
         Dictionary, beside Copy. Without it Android 11+ hides them from this app. -->
    <queries>
        <!-- Files (Cabinet): opens and saves files on e-ink screens when it is there. -->
        <package android:name="com.wanderwildwood.tana" />
        <!-- DuraSpeed, the Kompakt's background manager: only to say whether it is there. -->
        <package android:name="com.mediatek.duraspeed" />
        <!-- Glance, which shows today's events on the lock screen: only to say whether it is there. -->
        <package android:name="com.wanderwildwood.hitome" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The app that made an event and can show what it was made from (Wallet's card). -->
        <intent>
            <action android:name="android.provider.calendar.action.HANDLE_CUSTOM_EVENT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".KoyomiApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "The calendar app", for whatever asks for it by kind. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
        </activity>

        <!--
          Other apps' "add to calendar", "show this event" and "open this .ics", declared as
          Etar declares them (EditEventActivity, EventInfoActivity, ImportActivity). It opens
          in the asking app's task and goes back there when done.
        -->
        <activity
            android:name=".RequestActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <!-- A calendar file, by its type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
            <!--
              By its name, where the type says nothing (a download, a file manager). A path
              pattern stops at the first dot it can, so there is one per number of dots before
              the ".ics"; pathAdvancedPattern, which should not need that, matched nothing on
              Android 12.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.ics" />
                <data android:pathPattern=".*\\..*\\.ics" />
                <data android:pathPattern=".*\\..*\\..*\\.ics" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.ics" />
                <data android:pathPattern=".*\\.ICS" />
                <data android:pathPattern=".*\\..*\\.ICS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.ics" />
                <data android:pathPattern=".*\\..*\\.ics" />
                <data android:pathPattern=".*\\..*\\..*\\.ics" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.ics" />
                <data android:pathPattern=".*\\.ICS" />
                <data android:pathPattern=".*\\..*\\.ICS" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alerts.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <receiver
            android:name=".alerts.AlertReceiver"
            android:exported="true">
            <!-- The calendar store's own reminder broadcast. -->
            <intent-filter>
                <action android:name="android.intent.action.EVENT_REMINDER" />
                <data android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- The clock or the zone moved: all-day reminders are worked out on the phone's clock. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <!-- A sync changed the calendar store. -->
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data android:scheme="content" />
                <data android:host="com.android.calendar" />
            </intent-filter>
        </receiver>

        <!-- Today's events for Glance's lock-screen panel; it answers Glance alone. -->
        <provider
            android:name=".glance.TodayOnLockScreen"
            android:authorities="com.wanderwildwood.koyomi.glance"
            android:exported="true" />
        <!-- Followed calendar links fetched again every few hours (data/LinkRefresh.kt). -->
        <service
            android:name=".data.LinkRefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Calendar sync with a CalDAV server (davsync, after DAVx5) -->
        <service
            android:name="com.wanderwildwood.davsync.account.AccountAuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/davsync_authenticator" />
        </service>
        <service
            android:name="com.wanderwildwood.davsync.sync.adapter.CalendarsSyncAdapterService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/davsync_sync_calendars" />
        </service>
    </application>

</manifest>
