<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the links of followed calendars are secrets, left out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="subscriptions.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="subscriptions.xml" />
    </device-transfer>
</data-extraction-rules>
