    <!-- Reminders -->

    <!-- The notification channel's name, shown in the phone's settings -->
    <string name="alert_channel">Reminders</string>
    <!-- %1$d is minutes -->
    <string name="alert_snooze">Again in %1$d minutes</string>
    <string name="alert_dismiss">Dismiss</string>
    <string name="alert_open">Open the event</string>

    <!-- ============================================================ -->
    <!-- About dialog. Keep the names of the app, people, projects and licences as they are -->

    <!-- Heading. %1$s is the version number, e.g. 0.1.0 -->
    <string name="about_title">Calendar %1$s</string>
    <string name="about_privacy">It reads and writes the calendars already on the phone and never reaches the network. DAVx5, or the account the calendar came from, does the syncing.</string>
    <string name="about_sources">Reminders come from the phone\'s calendar store, so the ones set in Nextcloud ring here too.</string>
    <string name="about_after">After KompaktCalendar by David Anderlohr, GPL 3.0, and Etar, GPL 3.0, whose repeat rules and ways of saving a changed occurrence this follows. The repeat-rule parser is the Android Open Source Project\'s, Apache 2.0.</string>
    <!-- The name of the app's licence -->
    <string name="about_licence">GNU General Public License v3</string>
    <string name="about_icons">Icons from Material Symbols, Apache 2.0</string>
    <!-- The donation link label, beside a drawing of a llama. A fixed phrase: a verb and an object, so the reader knows what pressing it does -->
    <string name="about_feed_the_llamas">feed the llamas</string>
    <!-- Toast when the donation link cannot be opened -->
    <string name="about_no_browser">There is no browser on this phone to open that with.</string>
    <!-- Button that closes the About dialog -->
    <string name="about_close">Close</string>
