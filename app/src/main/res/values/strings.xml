    <string name="all_day">All day</string>
    <string name="today">Today</string>
    <!-- Buttons (verbs) -->
    <string name="ok">OK</string>
    <string name="cancel">Cancel</string>
    <string name="save">Save</string>
    <string name="done">Done</string>

    <!-- Top bar and foot buttons, read aloud by a screen reader -->
    <string name="cd_search">Search</string>
    <string name="cd_settings">Settings</string>
    <string name="cd_about">About</string>
    <string name="cd_close">Close</string>
    <string name="cd_discard">Discard</string>
