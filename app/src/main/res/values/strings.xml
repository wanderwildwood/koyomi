    <!-- ============================================================ -->
    <!-- First run, before calendar access -->

    <string name="permission_why">This app shows and changes the calendars already on the phone, so it needs to be let into them.</string>
    <string name="permission_davx5">To have a Nextcloud or other CalDAV calendar here, set it up in DAVx5 first. DAVx5 does the syncing; this app never reaches the network.</string>
    <string name="permission_allow">Allow calendar access</string>

